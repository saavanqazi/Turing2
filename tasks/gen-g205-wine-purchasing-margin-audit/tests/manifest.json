        "type": "deterministic",
        "expected": true,
        "deterministic": {
          "path": "$.is_file",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "results_figures",
      "metadata": {
        "how_justification": "Reads results.json with json.read_file and applies object_equals to every key with the key set closed; a failure names the key.",
        "why_justification": "The five counts and the shortfall total are the dashboard's headline figures; each is recomputable from the findings sheet and the governing purchase lines. Entailed by: \"A JSON object with exactly these keys and nothing else\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "json",
          "command": "read_file",
          "arguments": {
            "path": "results.json"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": {
          "keys": {
            "wine_count": {
              "value": 43,
              "tolerance": null
            },
            "margin_too_low_count": {
              "value": 15,
              "tolerance": null
            },
            "vintage_invalid_count": {
              "value": 6,
              "tolerance": null
            },
            "supplier_mismatch_count": {
              "value": 6,
              "tolerance": null
            },
            "compliant_count": {
              "value": 19,
              "tolerance": null
            },
            "margin_shortfall_total": {
              "value": 16.14,
              "tolerance": 0.01
            }
          },
          "closed": true
        },
        "deterministic": {
          "path": "$",
