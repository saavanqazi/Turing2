    {
      "name": "memo_names_findings",
      "metadata": {
        "how_justification": "Opens wine_memo.md with md.extract_text and applies a regex_match of look-aheads, one per flagged wine id, anywhere in the text; no wording or ordering is required.",
        "why_justification": "The memo explains each finding, so it must at least name each flagged wine. Entailed by: \"Name every wine that carries a finding, with the code and the reason\"",
        "tag": "incidental",
        "weight": 0.05
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "wine_memo.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?s)(?=.*\\bW\\-03\\b)(?=.*\\bW\\-04\\b)(?=.*\\bW\\-07\\b)(?=.*\\bW\\-10\\b)(?=.*\\bW\\-13\\b)(?=.*\\bW\\-14\\b)(?=.*\\bW\\-15\\b)(?=.*\\bW\\-16\\b)(?=.*\\bW\\-19\\b)(?=.*\\bW\\-20\\b)(?=.*\\bW\\-21\\b)(?=.*\\bW\\-22\\b)(?=.*\\bW\\-23\\b)(?=.*\\bW\\-25\\b)(?=.*\\bW\\-28\\b)(?=.*\\bW\\-29\\b)(?=.*\\bW\\-32\\b)(?=.*\\bW\\-35\\b)(?=.*\\bW\\-36\\b)(?=.*\\bW\\-38\\b)(?=.*\\bW\\-40\\b)(?=.*\\bW\\-41\\b)(?=.*\\bW\\-42\\b)(?=.*\\bW\\-43\\b)(?=.*\\bW\\-45\\b)(?=.*\\bW\\-46\\b)(?=.*\\bW\\-51\\b)(?=.*\\bW\\-54\\b)(?=.*\\bW\\-57\\b)(?=.*\\bW\\-58\\b)(?=.*\\bW\\-63\\b)(?=.*\\bW\\-65\\b)(?=.*\\bW\\-69\\b)(?=.*\\bW\\-71\\b)(?=.*\\bW\\-72\\b)(?=.*\\bW\\-75\\b)(?=.*\\bW\\-78\\b)(?=.*\\bW\\-79\\b)(?=.*\\bW\\-80\\b)(?=.*\\bW\\-87\\b)(?=.*\\bW\\-90\\b)(?=.*\\bW\\-92\\b)(?=.*\\bW\\-94\\b)(?=.*\\bW\\-95\\b)(?=.*\\bW\\-97\\b)(?=.*\\bW\\-98\\b)(?=.*\\bW\\-99\\b)(?=.*\\bW\\-102\\b)(?=.*\\bW\\-103\\b)(?=.*\\bW\\-106\\b)(?=.*\\bW\\-107\\b)(?=.*\\bW\\-108\\b)(?=.*\\bW\\-109\\b)(?=.*\\bW\\-110\\b)(?=.*\\bW\\-114\\b)(?=.*\\bW\\-117\\b)(?=.*\\bW\\-120\\b)(?=.*\\bW\\-121\\b)(?=.*\\bW\\-133\\b)(?=.*\\bW\\-124\\b)(?=.*\\bW\\-126\\b)(?=.*\\bW\\-127\\b)(?=.*\\bW\\-131\\b)(?=.*\\bW\\-132\\b)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
