    {
      "name": "memo_cites_futures",
      "metadata": {
        "how_justification": "Opens wine_memo.md with md.extract_text and applies a case-insensitive regex_match for the word 'futures' (or 'pre-arrival') anywhere in the text; no sentence shape is required.",
        "why_justification": "The memo ties the exemption to the clause that grants it. Entailed by: \"with the clause that exempts it\"",
        "tag": "incidental",
        "weight": 0.05
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
