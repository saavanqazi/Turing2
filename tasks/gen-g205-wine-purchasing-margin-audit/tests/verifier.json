    {
      "name": "memo_names_findings",
      "metadata": {
        "how_justification": "Opens wine_memo.md with md.extract_text and applies a regex_match of look-aheads, one per flagged wine id, anywhere in the text; no wording or ordering is required.",
        "why_justification": "The memo explains each finding, so it must at least name each flagged wine. Entailed by: \"Name every wine that carries a finding, with the code and the reason\"",
        "tag": "incidental",
        "weight": 0.05
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "wine_memo.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?s)(?=.*\\bW\\-04\\b)(?=.*\\bW\\-05\\b)(?=.*\\bW\\-06\\b)(?=.*\\bW\\-11\\b)(?=.*\\bW\\-13\\b)(?=.*\\bW\\-14\\b)(?=.*\\bW\\-15\\b)(?=.*\\bW\\-16\\b)(?=.*\\bW\\-17\\b)(?=.*\\bW\\-19\\b)(?=.*\\bW\\-24\\b)(?=.*\\bW\\-25\\b)(?=.*\\bW\\-30\\b)(?=.*\\bW\\-31\\b)(?=.*\\bW\\-32\\b)(?=.*\\bW\\-34\\b)(?=.*\\bW\\-35\\b)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "memo_names_trap",
      "metadata": {
        "how_justification": "Opens wine_memo.md with md.extract_text and applies a regex_match of look-aheads, one per exempt low-margin wine id, anywhere in the text; no wording or ordering is required.",
        "why_justification": "The memo names the wines under their minimum that the policy leaves compliant. Entailed by: \"name every wine whose realized margin is below its minimum but which the policy leaves compliant\"",
        "tag": "incidental",
        "weight": 0.05
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "wine_memo.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?s)(?=.*\\bW\\-02\\b)(?=.*\\bW\\-27\\b)(?=.*\\bW\\-34\\b)",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "memo_cites_futures",
      "metadata": {
        "how_justification": "Opens wine_memo.md with md.extract_text and applies a case-insensitive regex_match for the word 'futures' (or 'pre-arrival') anywhere in the text; no sentence shape is required.",
        "why_justification": "The memo ties the exemption to the clause that grants it. Entailed by: \"with the clause that exempts it\"",
        "tag": "incidental",
        "weight": 0.05
      },
      "source": {
        "type": "file",
        "file": {
          "type": "md",
          "command": "extract_text",
          "arguments": {
            "path": "wine_memo.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?i)\\b(futures|pre-?arrival)\\b",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
