{
  "task_id": "gen-G205-wine-purchasing-margin-audit",
  "verifiers": [
    {
      "name": "findings_exists",
      "metadata": {
        "how_justification": "Checks wine_findings.csv is present as a file in the workspace.",
        "why_justification": "The findings sheet is delivered. Entailed by: \"Give me `wine_findings.csv`, one row per wine with its finding\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "filesystem",
          "command": "check_path_exists",
          "arguments": {
            "path": "wine_findings.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": true,
        "deterministic": {
          "path": "$.is_file",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "findings_header",
      "metadata": {
        "how_justification": "Opens wine_findings.csv with csv.extract_text and applies a case- and quote-tolerant regex_match to the first line only.",
        "why_justification": "The contract document pins the header verbatim. Entailed by: \"Header, exactly: `wine_id,finding`\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "wine_findings.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?i)\\A\\x22?wine_id\\x22?[ \\t]*,[ \\t]*\\x22?finding\\x22?[ \\t]*\\r?\\n",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "findings_table_trap",
      "metadata": {
        "how_justification": "Parses wine_findings.csv with csv.read_rows and applies table_equals to the finding cell of each wine whose margin is below the minimum but which WM1 leaves compliant (matched by 'wine_id'); a failure names the exact row.",
        "why_justification": "A futures wine with an open allocation is exempt from WM1 whatever its margin; flagging it overstates the findings. Entailed by: \"`finding` is `compliant` for a wine with no finding\" and WM1's exemption clause.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "read_rows",
          "arguments": {
            "path": "wine_findings.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": {
          "id_column": "wine_id",
          "rows": {
            "W-02": {
              "finding": "compliant"
            },
            "W-17": {
              "finding": "compliant"
            },
            "W-29": {
              "finding": "VINTAGE_INVALID"
            },
            "W-30": {
              "finding": "compliant"
            }
          },
          "cell_types": {
            "finding": "text"
          }
        },
        "deterministic": {
          "path": "$",
          "comparison": "table_equals"
        }
      }
    },
    {
      "name": "findings_table",
      "metadata": {
        "how_justification": "Parses wine_findings.csv with csv.read_rows and applies table_equals: every graded cell of 127 rows plus the full 131-row population as a row_set lock (a duplicated or missing wine fails the lock), and the delivered column set closed to the stated header, with the finding cell compared as text (case-insensitive, whitespace-collapsed). A failure names the exact row.",
        "why_justification": "Every wine's finding under WM1-WM3 on its governing line, with codes joined in policy order, is graded. Entailed by: \"One row per wine, keyed by `wine_id` as `wine_purchases.csv` writes it, in any order. A wine that appears on more than one line of the purchasing table is one wine and one row ... joined with `|` in policy order\"",
        "tag": "core"
      },
