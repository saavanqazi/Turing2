          "arguments": {
            "path": "wine_memo.md"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?i)\\b(futures|pre-?arrival)\\b",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
