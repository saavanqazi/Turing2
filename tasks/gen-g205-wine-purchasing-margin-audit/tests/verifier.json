    {
      "name": "memo_exists",
      "metadata": {
        "how_justification": "Checks wine_memo.md is present as a file in the workspace.",
        "why_justification": "The memo is delivered. Entailed by: \"`wine_memo.md` explaining each finding and calling out the wines whose realized margin is under the minimum but which the policy still leaves compliant\"",
        "tag": "core"
      },
