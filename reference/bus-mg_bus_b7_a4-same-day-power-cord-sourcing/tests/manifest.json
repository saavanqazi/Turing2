    {
      "name": "evaluation_exists",
      "metadata": {
        "how_justification": "Checks offer_evaluation.csv is present as a file in the workspace.",
        "why_justification": "The offer comparison sheet is delivered.",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "filesystem",
          "command": "check_path_exists",
          "arguments": {
            "path": "offer_evaluation.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": true,
        "deterministic": {
          "path": "$.is_file",
          "comparison": "equals"
        }
      }
    },
    {
      "name": "evaluation_header",
      "metadata": {
        "how_justification": "Opens offer_evaluation.csv with csv.extract_text and applies regex_match.",
        "why_justification": "The contract document pins the header verbatim. Entailed by: \"Header, exactly: `offer_id,decision,reason_code,landed_cost_usd`\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "offer_evaluation.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?i)\\A\\x22?offer_id\\x22?[ \\t]*,[ \\t]*\\x22?decision\\x22?[ \\t]*,[ \\t]*\\x22?reason_code\\x22?[ \\t]*,[ \\t]*\\x22?landed_cost_usd\\x22?[ \\t]*\\r?\\n",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
    {
      "name": "evaluation_table_trap_of01",
      "metadata": {
        "how_justification": "Parses offer_evaluation.csv with csv.read_rows and applies table_equals to every graded cell of the OF-01 row (matched by 'offer_id'); a failure names the exact cell.",
        "why_justification": "Every offer's decision, its reason under the stated precedence and its landed cost are graded, so a clock read on the wrong side of the state line, a dropped fit clause or tax taken at the buyer's rate shows on the rows it moves. Entailed by: \"One row per offer in `same_day_offers.csv`, in any order, with `offer_id` as that file writes it: `decision` is `ELIGIBLE` or `INELIGIBLE`, `reason_code` is the first clause of the terms that refuses the offer and `NONE` for an offer nothing refuses, and `landed_cost_usd` is what the buyer pays for an eligible offer, in US dollars to the cent, and is left empty on an offer that is not eligible.\"",
        "tag": "core"
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "read_rows",
          "arguments": {
            "path": "offer_evaluation.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": {
          "id_column": "offer_id",
          "rows": {
            "OF-01": {
              "decision": "INELIGIBLE",
              "reason_code": "NO_STOCK",
              "landed_cost_usd": ""
            }
          },
          "cell_types": {
            "decision": "id",
            "reason_code": "id"
          }
        },
        "deterministic": {
          "path": "$",
          "comparison": "table_equals"
        }
      }
    },
